# ==============================================================================
# ALFA AI Trader — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to source control.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens. CHANGE THIS before deploying to production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
ALFA_SECRET=change_me_to_a_long_random_secret

# Path to the SQLite database file
DB_FILE=alfa_database.db

# Username of the app owner (has full free access and cannot be locked out)
OWNER_USERNAME=Anthony Jones

# ── Deriv API ─────────────────────────────────────────────────────────────────
# Your Deriv application ID (default public test app is 1089)
DERIV_APP_ID=1089

# ── Stripe Payments (optional — leave empty to disable paid plans) ────────────
# Live secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for each subscription tier
# Create these in your Stripe dashboard under Products → Prices
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BASIC_PRICE_ID=

# ── Optional overrides ────────────────────────────────────────────────────────
# Set to "production" in live environments
APP_ENV=development
